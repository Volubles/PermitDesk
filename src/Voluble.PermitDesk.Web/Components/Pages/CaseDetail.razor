@page "/cases/{Id:guid}"
@inject IDbContextFactory<PermitDeskDbContext> DbFactory
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ICaseStorage Storage
@inject ILogger<CaseDetail> Logger
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Voluble.PermitDesk.Web.Cases
@using Voluble.PermitDesk.Web.Components.Shared
@using Voluble.PermitDesk.Web.Data
@using Voluble.PermitDesk.Web.Domain
@using Voluble.PermitDesk.Web.Files

<PageTitle>@(_case?.CaseNumber ?? "Ärende") - PermitDesk</PageTitle>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_case is null)
{
    <MudAlert Severity="Severity.Error">Ärendet hittades inte.</MudAlert>
    <MudButton Variant="Variant.Text" Href="/cases" Class="mt-4">Tillbaka till ärendelistan</MudButton>
}
else
{
    <MudStack Spacing="4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/cases" />
            <MudText Typo="Typo.h4">@_case.CaseNumber</MudText>
        </MudStack>

        <MudPaper Class="pa-6" Elevation="0" Outlined="true">
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.h5">@_case.Title</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                        @_case.Address@(string.IsNullOrWhiteSpace(_case.Municipality) ? "" : $", {_case.Municipality}")
                    </MudText>
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex justify-end align-center">
                    <PublicationBadge Status="_case.PublicationStatus" Size="Size.Medium" Filled="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.h6" Class="mb-4">Status</MudText>
                    <MudSelect T="CaseStatus"
                               Value="_case.Status"
                               ValueChanged="OnStatusChanged"
                               Label="Ärendestatus"
                               Variant="Variant.Outlined"
                               Disabled="_saving">
                        @foreach (var status in Enum.GetValues<CaseStatus>())
                        {
                            <MudSelectItem Value="status">@StatusLabel(status)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                        Senast uppdaterad @_case.UpdatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.h6" Class="mb-4">Kontaktuppgifter</MudText>
                    <MudStack Spacing="2">
                        <DetailRow Label="Mäklare" Value="@_case.BrokerName" />
                        <DetailRow Label="Fotograf" Value="@_case.PhotographerName" />
                        <DetailRow Label="E-post" Value="@_case.ContactEmail" />
                        <DetailRow Label="Telefon" Value="@_case.ContactPhone" />
                        <DetailRow Label="Lantmäteriets ref." Value="@_case.LantmaterietReferenceNumber" />
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="pa-6" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">Lokal mapp</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-family: monospace;">
                        @(_case.LocalFolderPath ?? "(ingen mapp registrerad)")
                    </MudText>
                </MudStack>
                @if (!string.IsNullOrWhiteSpace(_case.LocalFolderPath))
                {
                    <MudTooltip Text="Kopiera sökväg">
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                       OnClick="CopyFolderPath" />
                    </MudTooltip>
                }
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-6" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-4">Ladda upp filer</MudText>

            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Class="mb-3">
                <MudSelect T="CaseFileCategory"
                           @bind-Value="_uploadCategory"
                           Label="Kategori"
                           Variant="Variant.Outlined"
                           Style="max-width: 280px;"
                           Disabled="_uploading">
                    @foreach (var cat in Enum.GetValues<CaseFileCategory>())
                    {
                        <MudSelectItem Value="cat">@CategoryLabel(cat)</MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Filer landar i @CaseFolderLayout.SubFolderFor(_uploadCategory)/
                </MudText>
            </MudStack>

            <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                           OnFilesChanged="OnFilesSelected"
                           AppendMultipleFiles="true"
                           MaximumFileCount="100" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                Dra in flera filer eller klicka för att välja. Stora drönarfiler stöds.
            </MudText>

            @if (_uploading)
            {
                <MudProgressLinear Indeterminate="true" Class="mt-3" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                    Laddar upp @_uploadingCurrent / @_uploadingTotal …
                </MudText>
            }
        </MudPaper>

        <MudPaper Class="pa-6" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">Filer</MudText>
            @if (_case.Files.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Inga filer uppladdade ännu.
                </MudText>
            }
            else
            {
                <MudTable Items="@_case.Files.OrderByDescending(f => f.UploadedAt)" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Filnamn</MudTh>
                        <MudTh>Kategori</MudTh>
                        <MudTh Style="text-align: right;">Storlek</MudTh>
                        <MudTh>Uppladdad</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Filnamn">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" />
                                <span>@context.FileName</span>
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Kategori">
                            <MudChip T="string" Size="Size.Small">@CategoryLabel(context.Category)</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Storlek" Style="text-align: right;">@FormatSize(context.SizeBytes)</MudTd>
                        <MudTd DataLabel="Uppladdad">@context.UploadedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudStack>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Case? _case;
    private bool _loading = true;
    private bool _saving;
    private bool _uploading;
    private int _uploadingCurrent;
    private int _uploadingTotal;
    private CaseFileCategory _uploadCategory = CaseFileCategory.Material;
    private const long MaxFileBytes = 5L * 1024 * 1024 * 1024;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _case = await db.Cases
            .Include(c => c.Files)
            .FirstOrDefaultAsync(c => c.Id == Id);
        _loading = false;
    }

    private async Task OnStatusChanged(CaseStatus newStatus)
    {
        if (_case is null || _case.Status == newStatus) return;

        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.Cases
                .Include(c => c.Files)
                .FirstAsync(c => c.Id == _case.Id);

            entity.Status = newStatus;
            entity.PublicationStatus = PublicationEligibility.Evaluate(entity, entity.Files.ToList());
            entity.UpdatedAt = DateTimeOffset.UtcNow;

            await db.SaveChangesAsync();

            _case.Status = entity.Status;
            _case.PublicationStatus = entity.PublicationStatus;
            _case.UpdatedAt = entity.UpdatedAt;

            Snackbar.Add($"Status uppdaterad till {StatusLabel(newStatus)}", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update case status");
            Snackbar.Add($"Kunde inte uppdatera status: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        if (_case is null) return;

        var files = e.GetMultipleFiles(maximumFileCount: 100);
        if (files.Count == 0) return;

        _uploading = true;
        _uploadingTotal = files.Count;
        _uploadingCurrent = 0;
        StateHasChanged();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Load Case without Files. We add new CaseFile rows via the DbSet
            // directly so EF tracks them as Added; using entity.Files.Add()
            // can confuse change detection into treating new rows as Modified.
            var entity = await db.Cases.FirstAsync(c => c.Id == _case.Id);

            var newFiles = new List<CaseFile>(files.Count);
            foreach (var file in files)
            {
                _uploadingCurrent++;
                StateHasChanged();

                await using var stream = file.OpenReadStream(MaxFileBytes);
                var saved = await Storage.SaveFileAsync(entity, _uploadCategory, file.Name, stream);

                var record = new CaseFile
                {
                    Id = Guid.NewGuid(),
                    CaseId = entity.Id,
                    FileName = Path.GetFileName(saved.LocalPath),
                    FileExtension = Path.GetExtension(saved.LocalPath),
                    ContentType = string.IsNullOrWhiteSpace(file.ContentType)
                        ? "application/octet-stream"
                        : file.ContentType,
                    SizeBytes = saved.SizeBytes,
                    Category = _uploadCategory,
                    StorageProvider = "local",
                    LocalPath = saved.LocalPath,
                    UploadedAt = DateTimeOffset.UtcNow,
                };
                db.CaseFiles.Add(record);
                newFiles.Add(record);
            }

            // Auto-transition: first Material file unblocks MaterialMissing.
            if (_uploadCategory == CaseFileCategory.Material
                && entity.Status == CaseStatus.MaterialMissing)
            {
                entity.Status = CaseStatus.MaterialReady;
            }

            // Re-evaluate publication eligibility using existing files in the DB
            // plus the ones we just added (still pending insert).
            var existingFiles = await db.CaseFiles
                .AsNoTracking()
                .Where(f => f.CaseId == entity.Id)
                .ToListAsync();
            var allFiles = existingFiles.Concat(newFiles).ToList();

            entity.PublicationStatus = PublicationEligibility.Evaluate(entity, allFiles);
            entity.UpdatedAt = DateTimeOffset.UtcNow;

            await db.SaveChangesAsync();

            // Reload fresh, detached, for the UI.
            _case = await db.Cases
                .AsNoTracking()
                .Include(c => c.Files)
                .FirstAsync(c => c.Id == entity.Id);

            Snackbar.Add($"{files.Count} fil(er) uppladdade", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to upload files");
            Snackbar.Add($"Uppladdning misslyckades: {ex.Message}", Severity.Error);
        }
        finally
        {
            _uploading = false;
            _uploadingCurrent = 0;
            _uploadingTotal = 0;
        }
    }

    private static string CategoryLabel(CaseFileCategory category) => category switch
    {
        CaseFileCategory.Material => "Material",
        CaseFileCategory.Application => "Ansökan",
        CaseFileCategory.SubmissionConfirmation => "Inskickningsbekräftelse",
        CaseFileCategory.Decision => "Beslut",
        CaseFileCategory.Other => "Övrigt",
        _ => category.ToString(),
    };

    private static string FormatSize(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double size = bytes;
        var u = 0;
        while (size >= 1024 && u < units.Length - 1)
        {
            size /= 1024;
            u++;
        }
        return $"{size:0.#} {units[u]}";
    }

    private async Task CopyFolderPath()
    {
        if (string.IsNullOrWhiteSpace(_case?.LocalFolderPath)) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _case.LocalFolderPath);
        Snackbar.Add("Sökväg kopierad", Severity.Info);
    }

    private static string StatusLabel(CaseStatus status) => status switch
    {
        CaseStatus.Draft => "Utkast",
        CaseStatus.MaterialMissing => "Material saknas",
        CaseStatus.MaterialReady => "Material klart",
        CaseStatus.ApplicationSubmitted => "Ansökan skickad",
        CaseStatus.WaitingForDecision => "Väntar på beslut",
        CaseStatus.Approved => "Godkänt",
        CaseStatus.Rejected => "Avslag",
        CaseStatus.ManualReviewRequired => "Kräver manuell kontroll",
        _ => status.ToString(),
    };
}
