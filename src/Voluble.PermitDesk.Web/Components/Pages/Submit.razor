@page "/cases/{Id:guid}/skicka"
@inject IDbContextFactory<PermitDeskDbContext> DbFactory
@inject IOptions<ApplicantOptions> Applicant
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<Submit> Logger
@inject SubmissionSessionStore SessionStore
@inject ILantmaterietSubmitter Submitter
@inject ICaseStorage Storage
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using Voluble.PermitDesk.Web.Data
@using Voluble.PermitDesk.Web.Domain
@using Voluble.PermitDesk.Web.Files
@using Voluble.PermitDesk.Web.Lantmateriet

<PageTitle>Skicka in ansökan - @(_case?.CaseNumber)</PageTitle>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_case is null)
{
    <MudAlert Severity="Severity.Error">Ärendet hittades inte.</MudAlert>
}
else
{
    <MudStack Spacing="4" Style="max-width: 880px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="@($"/cases/{Id}")" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">Skicka in ansökan</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_case.CaseNumber · @_case.Title</MudText>
            </MudStack>
        </MudStack>

        @if (string.IsNullOrWhiteSpace(_applicant.CompanyName))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                Sökandeuppgifter saknas. Lägg till <code>Lantmateriet:Applicant</code>-blocket i
                <code>appsettings.Local.json</code> innan du skickar in.
            </MudAlert>
        }

        <!-- 1. Sökande (read-only from config) -->
        <MudPaper Class="pa-6" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-3">1. Sökande</MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <ReadOnlyRow Label="Företag" Value="@_applicant.CompanyName" />
                    <ReadOnlyRow Label="Org.nummer" Value="@_applicant.OrganizationNumber" />
                    <ReadOnlyRow Label="Avdelning" Value="@_applicant.Department" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <ReadOnlyRow Label="Adress" Value="@_applicant.Address" />
                    <ReadOnlyRow Label="Postnummer / Ort" Value="@($"{_applicant.PostalCode} {_applicant.City}".Trim())" />
                    <ReadOnlyRow Label="Land" Value="@_applicant.Country" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- 2. Kontaktperson -->
        <MudPaper Class="pa-6" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-3">2. Kontaktperson</MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.ContactName" Label="Namn" Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.ContactPhone" Label="Telefon" InputType="InputType.Telephone" Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.ContactEmail" Label="E-post" InputType="InputType.Email" Required="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- 3. Material -->
        <MudPaper Class="pa-6" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-3">3. Material</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                Markera vilka typer av material som ingår i ansökan.
            </MudText>
            @foreach (var (type, label) in MaterialOptions)
            {
                <MudCheckBox T="bool"
                             Value="@HasMaterial(type)"
                             ValueChanged="@(v => SetMaterial(type, v))"
                             Label="@label" />
            }
        </MudPaper>

        <!-- 4. Ändamål -->
        <MudPaper Class="pa-6" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-3">4. Ändamål och egen referens</MudText>
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.PurposeStatement"
                                  Label="Ändamål (beskriv kort vad materialet ska användas till)"
                                  Variant="Variant.Outlined"
                                  Lines="4"
                                  Counter="2000"
                                  MaxLength="2000"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <ReadOnlyRow Label="Egen referens" Value="@_case.CaseNumber" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- Actions -->
        <MudPaper Class="pa-6" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">Skicka in</MudText>

            @if (_session is null || _session.Step is SubmissionStep.Cancelled or SubmissionStep.Failed or SubmissionStep.Completed)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Välj <strong>"Skicka in via automation"</strong> för att låta PermitDesk fylla i formuläret
                    åt dig. Webbläsaren öppnas synligt så du kan följa med, rita kartan och bekräfta innan
                    ansökan skickas. Använd <strong>"Öppna formulär manuellt"</strong> om du hellre vill
                    fylla i fälten själv.
                </MudText>

                @if (_session?.Step is SubmissionStep.Completed)
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-3">
                        Ansökan inskickad. Bekräftelse sparad i 02_Ansokan/.
                    </MudAlert>
                }
                else if (_session?.Step is SubmissionStep.Failed)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">
                        Inskickning misslyckades: @_session.ErrorMessage
                    </MudAlert>
                }
                else if (_session?.Step is SubmissionStep.Cancelled)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                        Avbruten av användaren.
                    </MudAlert>
                }

                <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                    <MudButton Variant="Variant.Text" Href="@($"/cases/{Id}")">Avbryt</MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               OnClick="OpenFormManually"
                               Disabled="_saving"
                               StartIcon="@Icons.Material.Filled.OpenInNew">
                        Öppna formulär manuellt
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="StartAutomation"
                               Disabled="_saving"
                               StartIcon="@Icons.Material.Filled.AutoFixHigh">
                        Skicka in via automation
                    </MudButton>
                </MudStack>
            }
            else
            {
                <MudAlert Severity="@(_session.Step is SubmissionStep.AwaitingConfirmation ? Severity.Warning : Severity.Info)"
                          Variant="Variant.Outlined"
                          Class="mb-3">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.body1"><strong>@StepLabel(_session.Step)</strong></MudText>
                        @if (!string.IsNullOrEmpty(_session.StatusMessage))
                        {
                            <MudText Typo="Typo.body2">@_session.StatusMessage</MudText>
                        }
                    </MudStack>
                </MudAlert>

                <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               OnClick="CancelAutomation"
                               StartIcon="@Icons.Material.Filled.Cancel">
                        Avbryt
                    </MudButton>
                    @if (_session.Step is SubmissionStep.AwaitingConfirmation)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   OnClick="ConfirmFinalSubmit"
                                   StartIcon="@Icons.Material.Filled.Send">
                            Skicka in nu
                        </MudButton>
                    }
                </MudStack>
            }
        </MudPaper>
    </MudStack>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Case? _case;
    private ApplicantOptions _applicant = new();
    private SubmitModel _model = new();
    private bool _loading = true;
    private bool _saving;
    private SubmissionSession? _session;

    private const string LantmaterietFormUrl = "https://www.lantmateriet.se/sv/spridningstillstand/ansokan/";

    private static readonly (DroneMaterialTypes Type, string Label)[] MaterialOptions =
    [
        (DroneMaterialTypes.Snedbilder, "Snedbilder (stillbilder med vyer)"),
        (DroneMaterialTypes.Lodbilder, "Lodbilder (stillbilder rakt ovanifrån)"),
        (DroneMaterialTypes.Video, "Video"),
        (DroneMaterialTypes.Ortofoto, "Ortofoto"),
        (DroneMaterialTypes.OvrigaData, "Övriga data"),
    ];

    protected override async Task OnInitializedAsync()
    {
        _applicant = Applicant.Value;

        await using var db = await DbFactory.CreateDbContextAsync();
        _case = await db.Cases.AsNoTracking().FirstOrDefaultAsync(c => c.Id == Id);
        if (_case is not null)
        {
            _model = SubmitModel.FromCase(_case);
        }
        _loading = false;

        // Reattach to an existing session if the broker refreshed the page mid-flow.
        var existing = SessionStore.Get(Id);
        if (existing is not null)
        {
            _session = existing;
            _session.StateChanged += OnSessionChanged;
        }
    }

    private async void OnSessionChanged()
    {
        await InvokeAsync(async () =>
        {
            // On completion, persist the screenshot + flip status.
            if (_session?.Step is SubmissionStep.Completed && _session.ConfirmationScreenshot is not null)
            {
                await PersistConfirmationAsync(_session.ConfirmationScreenshot);
            }
            StateHasChanged();
        });
    }

    private async Task PersistConfirmationAsync(byte[] pngBytes)
    {
        if (_case is null) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.Cases.FirstAsync(c => c.Id == Id);

            await using var stream = new MemoryStream(pngBytes);
            var fileName = $"ansokan-bekraftelse-{DateTimeOffset.UtcNow:yyyy-MM-dd-HHmmss}.png";
            var saved = await Storage.SaveFileAsync(entity, CaseFileCategory.Application, fileName, stream);

            db.CaseFiles.Add(new CaseFile
            {
                Id = Guid.NewGuid(),
                CaseId = entity.Id,
                FileName = Path.GetFileName(saved.LocalPath),
                FileExtension = ".png",
                ContentType = "image/png",
                SizeBytes = saved.SizeBytes,
                Category = CaseFileCategory.Application,
                StorageProvider = "local",
                LocalPath = saved.LocalPath,
                UploadedAt = DateTimeOffset.UtcNow,
                UploadedBy = "playwright-submitter",
            });

            entity.Status = CaseStatus.ApplicationSubmitted;
            entity.UpdatedAt = DateTimeOffset.UtcNow;

            await db.SaveChangesAsync();

            Snackbar.Add("Ansökan inskickad och bekräftelse sparad.", Severity.Success);

            SessionStore.End(Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist submission confirmation for case {CaseId}", Id);
            Snackbar.Add($"Ansökan inskickad men kunde inte spara bekräftelse: {ex.Message}", Severity.Warning);
        }
    }

    private async Task StartAutomation()
    {
        if (_case is null) return;
        await SaveModelAsync();

        var ctx = new SubmissionContext(
            CaseId: Id,
            CaseNumber: _case.CaseNumber,
            ContactName: _model.ContactName,
            ContactEmail: _model.ContactEmail,
            ContactPhone: _model.ContactPhone,
            MaterialTypes: _model.MaterialTypes,
            PurposeStatement: _model.PurposeStatement ?? string.Empty,
            Applicant: _applicant);

        _session = SessionStore.Start(ctx);
        _session.StateChanged += OnSessionChanged;

        _ = Task.Run(() => Submitter.RunAsync(_session));
    }

    private void ConfirmFinalSubmit() => _session?.Confirm();

    private void CancelAutomation()
    {
        _session?.Cancel();
        Snackbar.Add("Inskickning avbruten.", Severity.Info);
    }

    private static string StepLabel(SubmissionStep step) => step switch
    {
        SubmissionStep.Starting => "Initialiserar...",
        SubmissionStep.LaunchingBrowser => "Startar webbläsare...",
        SubmissionStep.FillingForm => "Fyller i formuläret...",
        SubmissionStep.AwaitingMap => "Väntar på kartritning",
        SubmissionStep.AwaitingConfirmation => "Klar att skicka — bekräfta",
        SubmissionStep.Submitting => "Skickar...",
        SubmissionStep.Completed => "Klar",
        SubmissionStep.Cancelled => "Avbruten",
        SubmissionStep.Failed => "Misslyckad",
        _ => step.ToString(),
    };

    private async Task SaveModelAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Cases.FirstAsync(c => c.Id == Id);
        entity.BrokerName = NullIfBlank(_model.ContactName) ?? entity.BrokerName;
        entity.ContactPhone = NullIfBlank(_model.ContactPhone);
        entity.ContactEmail = NullIfBlank(_model.ContactEmail);
        entity.MaterialTypes = _model.MaterialTypes;
        entity.PurposeStatement = NullIfBlank(_model.PurposeStatement);
        entity.UpdatedAt = DateTimeOffset.UtcNow;
        await db.SaveChangesAsync();
    }

    public void Dispose()
    {
        if (_session is not null)
        {
            _session.StateChanged -= OnSessionChanged;
        }
    }

    private bool HasMaterial(DroneMaterialTypes type) => _model.MaterialTypes.HasFlag(type);

    private void SetMaterial(DroneMaterialTypes type, bool on)
    {
        if (on) _model.MaterialTypes |= type;
        else _model.MaterialTypes &= ~type;
    }

    private async Task OpenFormManually()
    {
        if (_case is null) return;
        _saving = true;
        try
        {
            await SaveModelAsync();

            var payload = BuildClipboardPayload();
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", payload);
            await JS.InvokeVoidAsync("open", LantmaterietFormUrl, "_blank");

            Snackbar.Add(
                "Uppgifter sparade och kopierade till urklipp. Klistra in i Lantmäteriets formulär.",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to prepare submission");
            Snackbar.Add($"Kunde inte förbereda inskick: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private string BuildClipboardPayload()
    {
        var lines = new List<string>
        {
            "=== PermitDesk - Spridningstillstånd ===",
            $"Egen referens: {_case!.CaseNumber}",
            "",
            "--- Sökande ---",
            $"Företag: {_applicant.CompanyName}",
            $"Org.nummer: {_applicant.OrganizationNumber}",
            $"Adress: {_applicant.Address}",
            $"Postnummer: {_applicant.PostalCode}",
            $"Ort: {_applicant.City}",
            $"Land: {_applicant.Country}",
            "",
            "--- Kontaktperson ---",
            $"Namn: {_model.ContactName}",
            $"E-post: {_model.ContactEmail}",
            $"Telefon: {_model.ContactPhone}",
            "",
            "--- Material ---",
            $"Typer: {DescribeMaterial(_model.MaterialTypes)}",
            "",
            "--- Ändamål ---",
            _model.PurposeStatement ?? "",
        };
        return string.Join("\n", lines);
    }

    private static string DescribeMaterial(DroneMaterialTypes types)
    {
        if (types == DroneMaterialTypes.None) return "(inget valt)";
        var picks = new List<string>();
        if (types.HasFlag(DroneMaterialTypes.Snedbilder)) picks.Add("Snedbilder");
        if (types.HasFlag(DroneMaterialTypes.Lodbilder)) picks.Add("Lodbilder");
        if (types.HasFlag(DroneMaterialTypes.Video)) picks.Add("Video");
        if (types.HasFlag(DroneMaterialTypes.Ortofoto)) picks.Add("Ortofoto");
        if (types.HasFlag(DroneMaterialTypes.OvrigaData)) picks.Add("Övriga data");
        return string.Join(", ", picks);
    }

    private static string? NullIfBlank(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();

    private class SubmitModel
    {
        public string ContactName { get; set; } = string.Empty;
        public string ContactPhone { get; set; } = string.Empty;
        public string ContactEmail { get; set; } = string.Empty;
        public DroneMaterialTypes MaterialTypes { get; set; }
        public string? PurposeStatement { get; set; }

        public static SubmitModel FromCase(Case c) => new()
        {
            ContactName = c.BrokerName ?? string.Empty,
            ContactPhone = c.ContactPhone ?? string.Empty,
            ContactEmail = c.ContactEmail ?? string.Empty,
            MaterialTypes = c.MaterialTypes,
            PurposeStatement = c.PurposeStatement,
        };
    }
}
